
Project cotizaciones_v2 {
  database_type: 'PostgreSQL'
  Note: 'Modelo propuesto para Gestion de Cotizaciones V2. Borrador para revision. Los catalogos representados mediante parametro son administrados externamente por el servicio Parametros. Las tablas de Cotizaciones almacenan unicamente la referencia al identificador del catalogo y no duplican dichas tablas.'
}

TablePartial tabla_base {
  id serial [pk, note: 'Identificador unico del registro. Llave primaria autonumerica generada por la secuencia propia de la tabla, nombre_tabla_id_seq']
  activo boolean [not null, default: true]
  fecha_creacion timestamp [not null, default: `now()`, note: 'Fecha y hora de creacion del registro. Se asigna automaticamente al insertar']
}

TablePartial parametro {
  note: 'Catalogo administrado externamente por el servicio Parametros. Cotizaciones solo guarda la referencia a su identificador y no duplica la tabla.'

  id serial [pk, note: 'Identificador unico del valor del catalogo. Llave primaria autonumerica generada por la secuencia propia de la tabla, nombre_tabla_id_seq']
  nombre varchar(50) [not null, note: 'Nombre del valor del catalogo']
  descripcion varchar(250) [note: 'Descripcion del valor del catalogo']
  codigo_abreviacion varchar(20) [note: 'Codigo corto que identifica el valor del catalogo']
  activo boolean [not null, default: true]
}

// ---------------------------------------------------------------------------
// Creación de la solicitud de cotización
// ---------------------------------------------------------------------------

Table cotizaciones.solicitud_cotizacion {
  ~tabla_base
  numero_solicitud varchar(20) [unique, note: 'Numero de radicado de la solicitud. Se asigna al procesarla y es unico']
  consecutivo integer [note: 'Consecutivo de la solicitud dentro de la vigencia']
  vigencia smallint [not null, note: 'Anio fiscal de la necesidad asociada a la solicitud']
  unidad_ejecutora_id integer [not null, note: 'Llave foranea logica a la unidad ejecutora administrada en Kronos. Se valida por API']
  tipo_proceso_id integer [ref: > parametros.tipo_proceso.id, note: 'Llave foranea logica al catalogo parametros.tipo_proceso. Indica si es cotizacion o estudio de mercado']
  estado_id integer [not null, ref: > parametros.estado_solicitud.id, note: 'Llave foranea logica al catalogo parametros.estado_solicitud. Estado actual de la solicitud dentro del proceso']
  titulo text [note: 'Titulo de la cotizacion, copiado de la necesidad registrada en SICAPITAL']
  objetivo text [note: 'Objetivo y justificacion de la solicitud, copiados de SICAPITAL']
  requisitos text [note: 'Requisitos de la solicitud, copiados de SICAPITAL']
  observaciones text [note: 'Observaciones adicionales de la solicitud, copiadas de SICAPITAL']
  plazo_ejecucion varchar(250) [note: 'Plazo de ejecucion del contrato, copiado de SICAPITAL']
  criterio_seleccion text [note: 'Criterio con el que se seleccionara la cotizacion ganadora']
  plan_accion_id integer [note: 'Llave foranea logica al catalogo de planes de accion que estara en Parametros. Pendiente de validacion frente a los requerimientos']
  dependencia_solicitante_id integer [note: 'Llave foranea logica a la dependencia que solicita, administrada en Oikos. Se valida por API']
  dependencia_destino_id integer [note: 'Llave foranea logica a la dependencia destino de los bienes o servicios, administrada en Oikos. Se valida por API']
  ordenador_gasto_id integer [note: 'Llave foranea logica al ordenador del gasto de la solicitud. Origen por confirmar, persona en terceros']
  responsable_tercero_id integer [not null, note: 'Llave foranea logica a la persona que crea la solicitud, registrada en terceros. Se valida por API']
  tipo_necesidad_id integer [note: 'Llave foranea logica al catalogo de tipos de necesidad que estara en Parametros. Se calcula a partir de los items']
  tipo_contrato_id integer [note: 'Llave foranea logica al catalogo de tipos de contrato que estara en Parametros']
  medio_pago_id integer [note: 'Llave foranea logica al catalogo de medios de pago que estara en Parametros']
  tipo_forma_pago_id integer [ref: > parametros.tipo_forma_pago.id, note: 'Llave foranea logica al catalogo parametros.tipo_forma_pago. Indica si el pago es contraentrega o por pagos parciales']
  area_conocimiento_id integer [note: 'Llave foranea logica al catalogo de areas de conocimiento SNIES que estara en Parametros']
  nucleo_basico_id integer [note: 'Llave foranea logica al catalogo de nucleos basicos de conocimiento SNIES que estara en Parametros']
  fecha_apertura date [note: 'Fecha desde la cual los proveedores convocados pueden responder la solicitud']
  fecha_cierre date [note: 'Fecha de cierre de la recepcion de cotizaciones. Al menos tres dias habiles despues de la apertura']
  fecha_procesamiento timestamp [note: 'Fecha y hora en que la solicitud se proceso y se envio a los proveedores']
  fecha_modificacion timestamp [not null, default: `now()`, note: 'Fecha y hora de la ultima modificacion del registro']

  Note: 'Solicitud de cotizacion. Entidad central del modulo, una fila por solicitud, compartida por el solicitante y los proveedores convocados'
}

Table cotizaciones.solicitud_necesidad {
  ~tabla_base
  solicitud_id integer [not null, ref: > cotizaciones.solicitud_cotizacion.id, note: 'Llave foranea a cotizaciones.solicitud_cotizacion. Solicitud a la que pertenece la necesidad']
  numero_necesidad varchar(30) [not null, note: 'Numero de la necesidad en SICAPITAL. Se identifica junto con la unidad ejecutora y la vigencia de la solicitud']
  numero_disponibilidad varchar(30) [note: 'Numero del certificado de disponibilidad presupuestal, copiado de SICAPITAL']
  valor_disponibilidad numeric(20,7) [note: 'Valor en pesos de la disponibilidad presupuestal de la necesidad, copiado de SICAPITAL']
  valor_cdp numeric(20,7) [note: 'Valor en pesos del certificado de disponibilidad presupuestal, copiado de SICAPITAL. Se conserva junto a valor_disponibilidad hasta confirmar si son el mismo dato']
  rubro_codigo varchar(50) [note: 'Codigo del rubro presupuestal de la necesidad, copiado de SICAPITAL']
  rubro_nombre varchar(250) [note: 'Nombre del rubro presupuestal de la necesidad, copiado de SICAPITAL']
  dependencia_necesidad varchar(250) [note: 'Nombre de la dependencia de la necesidad, copiado de SICAPITAL']
  estado_necesidad varchar(50) [note: 'Estado de la necesidad en SICAPITAL al momento de la copia']
  fecha_modificacion timestamp [not null, default: `now()`, note: 'Fecha y hora de la ultima modificacion del registro']

  indexes {
    (solicitud_id, numero_necesidad) [unique]
  }
  Note: 'Necesidades y datos presupuestales de SICAPITAL asociados a la solicitud. Una fila por necesidad'
}

Table cotizaciones.solicitud_item {
  ~tabla_base
  solicitud_id integer [not null, ref: > cotizaciones.solicitud_cotizacion.id, note: 'Llave foranea a cotizaciones.solicitud_cotizacion. Solicitud a la que pertenece el item']
  tipo_bien_servicio_id integer [not null, note: 'Llave foranea logica al catalogo de tipos de necesidad que estara en Parametros. Indica si el item es bien o servicio']
  nombre varchar(250) [not null, note: 'Nombre del bien o servicio solicitado']
  descripcion text [not null, note: 'Descripcion y ficha tecnica del bien o servicio solicitado']
  unidad_medida_id integer [note: 'Llave foranea logica al catalogo de unidades de medida que estara en Parametros']
  cantidad numeric(14,2) [not null, note: 'Cantidad solicitada del bien o servicio']
  cargue_masivo_id integer [ref: > cotizaciones.cargue_masivo.id, note: 'Llave foranea a cotizaciones.cargue_masivo. Cargue del que proviene el item, vacio si se registro individualmente']
  codigo_unspsc varchar(10) [note: 'Codigo UNSPSC del bien o servicio. Por confirmar si se adopta']
  fecha_modificacion timestamp [not null, default: `now()`, note: 'Fecha y hora de la ultima modificacion del registro']

  Note: 'Bienes y servicios solicitados en la solicitud de cotizacion. Una fila por item'
}

Table cotizaciones.cargue_masivo {
  ~tabla_base
  solicitud_id integer [not null, ref: > cotizaciones.solicitud_cotizacion.id, note: 'Llave foranea a cotizaciones.solicitud_cotizacion. Solicitud en la que se cargaron los items']
  plantilla_id integer [not null, ref: > parametros.plantilla_cargue.id, note: 'Llave foranea logica al catalogo parametros.plantilla_cargue. Plantilla usada en el cargue']
  documento_id integer [not null, note: 'Llave foranea logica al archivo cargado en el gestor documental']
  nombre_archivo varchar(255) [not null, note: 'Nombre original del archivo cargado']
  cargado_por_tercero_id integer [not null, note: 'Llave foranea logica a la persona que realizo el cargue, registrada en terceros']
  total_registros integer [not null, note: 'Cantidad total de registros procesados en el archivo']
  aceptados integer [not null, note: 'Cantidad de registros aceptados e incorporados como items']
  rechazados integer [not null, note: 'Cantidad de registros rechazados por inconsistencias']
  estado_id integer [not null, note: 'Llave foranea logica al catalogo de estados del cargue masivo que estara en Parametros. Resultado del procesamiento del archivo']
  fecha_modificacion timestamp [not null, default: `now()`, note: 'Fecha y hora de la ultima modificacion del registro']

  Note: 'Cargues masivos de items realizados con plantilla en una solicitud. Una fila por archivo cargado'
}

Table cotizaciones.cargue_masivo_error {
  ~tabla_base
  cargue_masivo_id integer [not null, ref: > cotizaciones.cargue_masivo.id, note: 'Llave foranea a cotizaciones.cargue_masivo. Cargue en el que se detecto el error']
  hoja varchar(30) [not null, note: 'Hoja de la plantilla donde esta el registro rechazado, BIEN o SERVICIO']
  fila integer [not null, note: 'Numero de fila del registro rechazado en la plantilla']
  campo varchar(50) [note: 'Campo de la plantilla que presenta el error']
  valor_detectado varchar(500) [note: 'Valor encontrado en el campo con error']
  motivo_id integer [note: 'Llave foranea logica al catalogo de motivos de rechazo del cargue que estara en Parametros']
  detalle text [note: 'Mensaje del validador que explica el error']
  fecha_modificacion timestamp [not null, default: `now()`, note: 'Fecha y hora de la ultima modificacion del registro']

  Note: 'Errores detectados al validar un cargue masivo. Una fila por error'
}

Table cotizaciones.solicitud_pago_parcial {
  ~tabla_base
  solicitud_id integer [not null, ref: > cotizaciones.solicitud_cotizacion.id, note: 'Llave foranea a cotizaciones.solicitud_cotizacion. Solicitud a la que pertenece la condicion de pago']
  condicion text [not null, note: 'Hito o entregable que habilita el pago']
  porcentaje numeric(5,4) [not null, note: 'Proporcion del valor total que se paga en esta condicion, expresada como fraccion, por ejemplo 0.3000 para 30 por ciento. La suma por solicitud debe ser 1']
  fecha_modificacion timestamp [not null, default: `now()`, note: 'Fecha y hora de la ultima modificacion del registro']

  Note: 'Condiciones de pago de la solicitud. Una fila por condicion'
}

Table cotizaciones.solicitud_ciiu {
  ~tabla_base
  solicitud_id integer [not null, ref: > cotizaciones.solicitud_cotizacion.id, note: 'Llave foranea a cotizaciones.solicitud_cotizacion. Solicitud a la que pertenece la actividad economica']
  actividad_economica_id integer [not null, note: 'Llave foranea logica al catalogo actividad_economica que estara en Parametros. Codigo CIIU elegido']
  fecha_modificacion timestamp [not null, default: `now()`, note: 'Fecha y hora de la ultima modificacion del registro']

  indexes {
    (solicitud_id, actividad_economica_id) [unique]
  }
  Note: 'Actividades economicas CIIU elegidas para la solicitud. Una fila por actividad'
}

Table cotizaciones.documento_solicitud {
  ~tabla_base
  solicitud_id integer [not null, ref: > cotizaciones.solicitud_cotizacion.id, note: 'Llave foranea a cotizaciones.solicitud_cotizacion. Solicitud a la que pertenece el anexo']
  tipo_documento_id integer [note: 'Llave foranea logica al catalogo tipo_documento que estara en Parametros']
  documento_id integer [not null, note: 'Llave foranea logica al archivo almacenado en el gestor documental']
  nombre_archivo varchar(255) [not null, note: 'Nombre original del archivo anexado']
  extension varchar(10) [not null, note: 'Extension del archivo anexado']
  tamano_bytes bigint [not null, note: 'Tamanio del archivo en bytes']
  cargado_por_tercero_id integer [not null, note: 'Llave foranea logica a la persona que cargo el archivo, registrada en terceros']
  fecha_modificacion timestamp [not null, default: `now()`, note: 'Fecha y hora de la ultima modificacion del registro']

  Note: 'Anexos que adjunta el jefe de dependencia a la solicitud. Una fila por documento'
}

Table cotizaciones.solicitud_requisito_documental {
  ~tabla_base
  solicitud_id integer [not null, ref: > cotizaciones.solicitud_cotizacion.id, note: 'Llave foranea a cotizaciones.solicitud_cotizacion. Solicitud que exige el documento']
  tipo_documento_id integer [not null, note: 'Llave foranea logica al catalogo tipo_documento que estara en Parametros. Documento exigido al oferente']
  clasificacion_id integer [not null, note: 'Llave foranea logica al catalogo de clasificacion del requisito documental que estara en Parametros. Obligatorio o complementario']
  instruccion text [note: 'Instruccion para el oferente sobre el documento exigido']
  fecha_modificacion timestamp [not null, default: `now()`, note: 'Fecha y hora de la ultima modificacion del registro']

  indexes {
    (solicitud_id, tipo_documento_id) [unique]
  }
  Note: 'Documentos que el oferente debe aportar para la solicitud. Una fila por documento exigido'
}

Table cotizaciones.solicitud_proveedor {
  ~tabla_base
  solicitud_id integer [not null, ref: > cotizaciones.solicitud_cotizacion.id, note: 'Llave foranea a cotizaciones.solicitud_cotizacion. Solicitud a la que se convoca al proveedor']
  proveedor_id integer [not null, note: 'Llave foranea logica al proveedor del registro de proveedores, con identidad en terceros. Se valida por API']
  fecha_convocatoria timestamp [not null, note: 'Fecha y hora en que el proveedor fue convocado al procesar la solicitud']
  fecha_modificacion timestamp [not null, default: `now()`, note: 'Fecha y hora de la ultima modificacion del registro']

  indexes {
    (solicitud_id, proveedor_id) [unique]
  }
  Note: 'Proveedores convocados a la solicitud. Una fila por proveedor'
}

// ---------------------------------------------------------------------------
// Gestión de la solicitud después de procesarla
// ---------------------------------------------------------------------------

Table cotizaciones.observacion {
  ~tabla_base
  solicitud_id integer [not null, ref: > cotizaciones.solicitud_cotizacion.id, note: 'Llave foranea a cotizaciones.solicitud_cotizacion. Solicitud sobre la que se hace la observacion']
  proveedor_convocado_id integer [not null, ref: > cotizaciones.solicitud_proveedor.id, note: 'Llave foranea a cotizaciones.solicitud_proveedor. Proveedor convocado que escribe la observacion']
  texto text [not null, note: 'Texto de la observacion del proveedor']
  estado_id integer [ref: > parametros.estado_observacion.id, note: 'Llave foranea logica al catalogo parametros.estado_observacion. Estado de la observacion, enviada, vista o respondida']
  fecha_vista timestamp [note: 'Fecha y hora en que el solicitante reviso la observacion. Vacio si no se ha revisado']
  fecha_modificacion timestamp [not null, default: `now()`, note: 'Fecha y hora de la ultima modificacion del registro']

  Note: 'Observaciones de los proveedores convocados sobre la solicitud. Una fila por observacion'
}

Table cotizaciones.respuesta_observacion {
  ~tabla_base
  observacion_id integer [not null, ref: > cotizaciones.observacion.id, note: 'Llave foranea a cotizaciones.observacion. Observacion que se responde']
  autor_tercero_id integer [not null, note: 'Llave foranea logica a la persona que responde, solicitante u ordenador, registrada en terceros']
  texto text [not null, note: 'Texto de la respuesta de la Universidad']
  publica boolean [note: 'Indica si la respuesta es visible para todos los oferentes o solo para el autor de la observacion']
  fecha_modificacion timestamp [not null, default: `now()`, note: 'Fecha y hora de la ultima modificacion del registro']

  Note: 'Respuestas de la Universidad a las observaciones de los proveedores. Una fila por respuesta'
}

Table cotizaciones.cotizacion {
  ~tabla_base
  proveedor_convocado_id integer [not null, unique, ref: - cotizaciones.solicitud_proveedor.id, note: 'Llave foranea unica a cotizaciones.solicitud_proveedor. Proveedor convocado que presenta la cotizacion, una por proveedor']
  estado_id integer [not null, ref: > parametros.estado_cotizacion.id, note: 'Llave foranea logica al catalogo parametros.estado_cotizacion. Estado actual de la cotizacion']
  fecha_primer_envio timestamp [note: 'Fecha y hora en que el proveedor envio la primera version']
  fecha_modificacion timestamp [not null, default: `now()`, note: 'Fecha y hora de la ultima modificacion del registro']

  Note: 'Cotizacion presentada por un proveedor convocado. El contenido se guarda por versiones'
}

Table cotizaciones.cotizacion_version {
  ~tabla_base
  cotizacion_id integer [not null, ref: > cotizaciones.cotizacion.id, note: 'Llave foranea a cotizaciones.cotizacion. Cotizacion a la que pertenece la version']
  numero_version smallint [not null, note: 'Numero de la version dentro de la cotizacion, 1 para la inicial']
  motivo_id integer [not null, ref: > parametros.motivo_version.id, note: 'Llave foranea logica al catalogo parametros.motivo_version. Motivo de la version, inicial, adenda o subsanacion']
  solicitud_modificacion_id integer [ref: > cotizaciones.solicitud_modificacion.id, note: 'Llave foranea a cotizaciones.solicitud_modificacion. Modificacion que origino la version, obligatoria si el motivo es adenda']
  periodo_subsanacion_id integer [ref: > cotizaciones.periodo_subsanacion.id, note: 'Llave foranea a cotizaciones.periodo_subsanacion. Periodo en que se presento la version, obligatorio si el motivo es subsanacion']
  estado_version_id integer [not null, ref: > parametros.estado_version.id, note: 'Llave foranea logica al catalogo parametros.estado_version. Estado de la version, borrador, enviada o reemplazada']
  fecha_vencimiento date [note: 'Fecha hasta la cual el proveedor mantiene vigente la cotizacion']
  descuentos text [note: 'Descuentos ofrecidos por el proveedor']
  observaciones text [note: 'Observaciones adicionales del proveedor sobre la cotizacion']
  fecha_envio timestamp [note: 'Fecha y hora en que el proveedor envio la version']
  fecha_modificacion timestamp [not null, default: `now()`, note: 'Fecha y hora de la ultima modificacion del registro']

  indexes {
    (cotizacion_id, numero_version) [unique]
  }
  Note: 'Versiones de la cotizacion del proveedor. Una version enviada no se modifica. Una fila por version'
}

Table cotizaciones.cotizacion_version_item {
  ~tabla_base
  cotizacion_version_id integer [not null, ref: > cotizaciones.cotizacion_version.id, note: 'Llave foranea a cotizaciones.cotizacion_version. Version a la que pertenece el precio']
  solicitud_item_id integer [not null, ref: > cotizaciones.solicitud_item.id, note: 'Llave foranea a cotizaciones.solicitud_item. Item de la solicitud que se cotiza']
  cantidad numeric(14,2) [not null, note: 'Cantidad del item al momento de crear la version, copiada de la solicitud']
  valor_unitario numeric(20,7) [not null, note: 'Valor unitario ofrecido por el proveedor antes de IVA']
  tarifa_iva_id integer [not null, note: 'Llave foranea logica al catalogo de tarifas de IVA que estara en Parametros']
  porcentaje_iva numeric(5,4) [not null, note: 'Tarifa de IVA vigente al enviar la version, expresada como fraccion, por ejemplo 0.1900 para 19 por ciento. Copiada de la tarifa']
  ficha_tecnica text [note: 'Descripcion del bien o servicio ofrecido por el proveedor']
  fecha_modificacion timestamp [not null, default: `now()`, note: 'Fecha y hora de la ultima modificacion del registro']

  indexes {
    (cotizacion_version_id, solicitud_item_id) [unique]
  }
  Note: 'Precio, IVA y ficha tecnica ofrecidos por item en cada version de la cotizacion. Una fila por item y version'
}

Table cotizaciones.documento_cotizacion {
  ~tabla_base
  cotizacion_id integer [not null, ref: > cotizaciones.cotizacion.id, note: 'Llave foranea a cotizaciones.cotizacion. Cotizacion a la que pertenece el documento']
  requisito_documental_id integer [ref: > cotizaciones.solicitud_requisito_documental.id, note: 'Llave foranea a cotizaciones.solicitud_requisito_documental. Requisito que cumple el documento, vacio si es un adjunto libre']
  cotizacion_version_id integer [not null, ref: > cotizaciones.cotizacion_version.id, note: 'Llave foranea a cotizaciones.cotizacion_version. Version en la que se cargo el documento']
  documento_id integer [not null, note: 'Llave foranea logica al archivo almacenado en el gestor documental']
  nombre_archivo varchar(255) [not null, note: 'Nombre original del archivo cargado']
  extension varchar(10) [not null, note: 'Extension del archivo cargado']
  tamano_bytes bigint [not null, note: 'Tamanio del archivo en bytes']
  reemplaza_a_id integer [ref: > cotizaciones.documento_cotizacion.id, note: 'Llave foranea a cotizaciones.documento_cotizacion. Documento anterior que este reemplaza en una subsanacion']
  cargado_por_tercero_id integer [not null, note: 'Llave foranea logica a la persona que cargo el archivo, registrada en terceros']
  fecha_modificacion timestamp [not null, default: `now()`, note: 'Fecha y hora de la ultima modificacion del registro']

  Note: 'Documentos que adjunta el proveedor a su cotizacion. Una fila por documento'
}

Table cotizaciones.periodo_subsanacion {
  ~tabla_base
  solicitud_id integer [not null, ref: > cotizaciones.solicitud_cotizacion.id, note: 'Llave foranea a cotizaciones.solicitud_cotizacion. Solicitud en la que se habilita la subsanacion']
  proveedor_convocado_id integer [ref: > cotizaciones.solicitud_proveedor.id, note: 'Llave foranea a cotizaciones.solicitud_proveedor. Proveedor al que aplica el periodo, vacio si aplica a todos']
  fecha_inicio timestamp [not null, note: 'Fecha y hora de inicio del periodo de subsanacion']
  fecha_fin timestamp [not null, note: 'Fecha y hora de fin del periodo de subsanacion. Debe ser posterior al inicio']
  motivo text [not null, note: 'Motivo por el que se habilita la subsanacion']
  habilitado_por_tercero_id integer [not null, note: 'Llave foranea logica a la persona que habilito el periodo, registrada en terceros']
  fecha_modificacion timestamp [not null, default: `now()`, note: 'Fecha y hora de la ultima modificacion del registro']

  Note: 'Periodos en los que se habilita la subsanacion de documentos de las cotizaciones. Una fila por periodo'
}

Table cotizaciones.decision_solicitante {
  ~tabla_base
  cotizacion_id integer [not null, unique, ref: - cotizaciones.cotizacion.id, note: 'Llave foranea unica a cotizaciones.cotizacion. Cotizacion sobre la que se decide, una decision por cotizacion']
  cotizacion_version_id integer [not null, ref: > cotizaciones.cotizacion_version.id, note: 'Llave foranea a cotizaciones.cotizacion_version. Version evaluada, debe ser la vigente']
  resultado_id integer [not null, note: 'Llave foranea logica al catalogo de resultados de la decision que estara en Parametros. Aprobado o rechazado']
  mensaje_proveedor text [not null, note: 'Respuesta o recomendacion que recibe el proveedor']
  justificacion_seleccion text [note: 'Razones de la seleccion del proveedor. Obligatoria si el resultado es aprobado']
  decidido_por_tercero_id integer [not null, note: 'Llave foranea logica a la persona que registra la decision, registrada en terceros']
  fecha_modificacion timestamp [not null, default: `now()`, note: 'Fecha y hora de la ultima modificacion del registro']

  Note: 'Decision del solicitante sobre la cotizacion de un proveedor. La fecha de creacion es la fecha de la decision'
}

Table cotizaciones.validacion_ordenador {
  ~tabla_base
  solicitud_id integer [not null, ref: > cotizaciones.solicitud_cotizacion.id, note: 'Llave foranea a cotizaciones.solicitud_cotizacion. Solicitud que se valida']
  decision_cotizacion_id integer [not null, ref: > cotizaciones.decision_solicitante.id, note: 'Llave foranea a cotizaciones.decision_solicitante. Decision del solicitante que se valida']
  decision_id integer [not null, note: 'Llave foranea logica al catalogo de resultados de la decision que estara en Parametros. Aprueba o rechaza']
  observaciones text [note: 'Observaciones del ordenador del gasto sobre la validacion']
  ordenador_tercero_id integer [not null, note: 'Llave foranea logica al ordenador del gasto que valida, registrado en terceros']
  fecha_modificacion timestamp [not null, default: `now()`, note: 'Fecha y hora de la ultima modificacion del registro']

  Note: 'Validacion del ordenador del gasto sobre la decision del solicitante. Una fila por validacion'
}

Table cotizaciones.solicitud_modificacion {
  ~tabla_base
  solicitud_id integer [not null, ref: > cotizaciones.solicitud_cotizacion.id, note: 'Llave foranea a cotizaciones.solicitud_cotizacion. Solicitud que se modifica']
  numero smallint [not null, note: 'Numero de la modificacion dentro de la solicitud, el que ven los usuarios']
  fecha_modificacion timestamp [not null, default: `now()`, note: 'Fecha y hora de la ultima modificacion del registro']

  indexes {
    (solicitud_id, numero) [unique]
  }
  Note: 'Modificaciones solicitadas sobre una solicitud ya procesada. El estado, la justificacion y las fechas se obtienen del historial'
}

Table cotizaciones.solicitud_modificacion_estado {
  ~tabla_base
  solicitud_modificacion_id integer [not null, ref: > cotizaciones.solicitud_modificacion.id, note: 'Llave foranea a cotizaciones.solicitud_modificacion. Modificacion a la que pertenece el cambio de estado']
  estado_id integer [not null, ref: > parametros.estado_modificacion.id, note: 'Llave foranea logica al catalogo parametros.estado_modificacion. Estado al que pasa la modificacion']
  responsable_tercero_id integer [note: 'Llave foranea logica a la persona que realiza el cambio, registrada en terceros. Vacio si lo realiza el sistema']
  justificacion text [note: 'Justificacion del cambio de estado']
  fecha_modificacion timestamp [not null, default: `now()`, note: 'Fecha y hora de la ultima modificacion del registro']

  Note: 'Historial de estados de cada solicitud de modificacion. Una fila por cambio de estado'
}

Table cotizaciones.solicitud_modificacion_detalle {
  ~tabla_base
  solicitud_modificacion_id integer [not null, ref: > cotizaciones.solicitud_modificacion.id, note: 'Llave foranea a cotizaciones.solicitud_modificacion. Modificacion a la que pertenece el cambio']
  tipo_cambio_id integer [not null, ref: > parametros.tipo_cambio_modificacion.id, note: 'Llave foranea logica al catalogo parametros.tipo_cambio_modificacion. Tipo de cambio realizado']
  solicitud_item_id integer [ref: > cotizaciones.solicitud_item.id, note: 'Llave foranea a cotizaciones.solicitud_item. Item modificado, obligatorio en cambios de items']
  valor_anterior jsonb [note: 'JSON con los campos del item o la fecha antes del cambio, por ejemplo nombre, descripcion, unidad, cantidad o fecha de cierre']
  valor_nuevo jsonb [note: 'JSON con los mismos campos despues del cambio']
  justificacion text [note: 'Justificacion del cambio']
  fecha_modificacion timestamp [not null, default: `now()`, note: 'Fecha y hora de la ultima modificacion del registro']

  Note: 'Detalle de los cambios de cada modificacion de la solicitud. Una fila por cambio'
}

Table cotizaciones.solicitud_estado {
  ~tabla_base
  solicitud_id integer [not null, ref: > cotizaciones.solicitud_cotizacion.id, note: 'Llave foranea a cotizaciones.solicitud_cotizacion. Solicitud a la que pertenece el cambio de estado']
  estado_id integer [not null, ref: > parametros.estado_solicitud.id, note: 'Llave foranea logica al catalogo parametros.estado_solicitud. Estado al que pasa la solicitud']
  responsable_tercero_id integer [note: 'Llave foranea logica a la persona que realiza el cambio, registrada en terceros. Vacio si lo realiza el sistema']
  justificacion text [note: 'Justificacion del cambio de estado']
  fecha_modificacion timestamp [not null, default: `now()`, note: 'Fecha y hora de la ultima modificacion del registro']

  Note: 'Historial de estados de la solicitud. Una fila por cambio de estado'
}

Table cotizaciones.cotizacion_estado {
  ~tabla_base
  cotizacion_id integer [not null, ref: > cotizaciones.cotizacion.id, note: 'Llave foranea a cotizaciones.cotizacion. Cotizacion a la que pertenece el cambio de estado']
  estado_id integer [not null, ref: > parametros.estado_cotizacion.id, note: 'Llave foranea logica al catalogo parametros.estado_cotizacion. Estado al que pasa la cotizacion']
  responsable_tercero_id integer [note: 'Llave foranea logica a la persona que realiza el cambio, registrada en terceros. Vacio si lo realiza el sistema']
  justificacion text [note: 'Justificacion del cambio de estado']
  fecha_modificacion timestamp [not null, default: `now()`, note: 'Fecha y hora de la ultima modificacion del registro']

  Note: 'Historial de estados de la cotizacion del proveedor. Una fila por cambio de estado'
}

Table cotizaciones.notificacion {
  ~tabla_base
  solicitud_id integer [not null, ref: > cotizaciones.solicitud_cotizacion.id, note: 'Llave foranea a cotizaciones.solicitud_cotizacion. Solicitud que origina la notificacion']
  evento_id integer [not null, ref: > parametros.evento_notificacion.id, note: 'Llave foranea logica al catalogo parametros.evento_notificacion. Evento del proceso que genera la notificacion']
  proveedor_convocado_id integer [ref: > cotizaciones.solicitud_proveedor.id, note: 'Llave foranea a cotizaciones.solicitud_proveedor. Proveedor destinatario, vacio si el destinatario no es un oferente']
  destinatario_tercero_id integer [not null, note: 'Llave foranea logica a la persona que recibe la notificacion, registrada en terceros']
  canal_id integer [not null, note: 'Llave foranea logica al catalogo de canales de notificacion que estara en Parametros']
  estado_envio_id integer [not null, note: 'Llave foranea logica al catalogo de estados de envio que estara en Parametros. Resultado del envio']
  intentos smallint [not null, default: 0, note: 'Cantidad de intentos de envio realizados']
  ultimo_error text [note: 'Mensaje del ultimo error de envio. Vacio si no hubo error']
  fecha_envio timestamp [note: 'Fecha y hora en que la notificacion se envio con exito']
  fecha_modificacion timestamp [not null, default: `now()`, note: 'Fecha y hora de la ultima modificacion del registro']

  Note: 'Notificaciones generadas por eventos del proceso de la solicitud. Una fila por notificacion y destinatario'
}

// ---------------------------------------------------------------------------
// Catálogos propios de cotizaciones administrados externamente por el servicio Parámetros
// (representación lógica; no se crean en la base de Cotizaciones)
// ---------------------------------------------------------------------------

Table parametros.tipo_proceso {
  ~parametro
  Note: 'Catalogo de tipos de proceso de la solicitud. Valores, cotizacion y estudio de mercado'
}

Table parametros.tipo_forma_pago {
  ~parametro
  Note: 'Catalogo de tipos de forma de pago. Valores, contraentrega y pagos parciales'
}

Table parametros.estado_solicitud {
  ~parametro
  Note: 'Catalogo de estados de la solicitud. Valores propuestos, borrador, publicada, abierta, cerrada, en evaluacion, seleccionada, validada, desierta y cancelada'
}

Table parametros.estado_observacion {
  ~parametro
  Note: 'Catalogo de estados de la observacion. Valores, enviada, vista y respondida'
}

Table parametros.estado_cotizacion {
  ~parametro
  Note: 'Catalogo de estados de la cotizacion. Valores propuestos, en diligenciamiento, enviada, requiere actualizacion, en subsanacion, aprobada y rechazada'
}

Table parametros.motivo_version {
  ~parametro
  Note: 'Catalogo de motivos de version de la cotizacion. Valores propuestos, inicial, adenda y subsanacion'
}

Table parametros.estado_version {
  ~parametro
  Note: 'Catalogo de estados de la version de la cotizacion. Valores propuestos, borrador, enviada y reemplazada'
}

Table parametros.estado_modificacion {
  ~parametro
  Note: 'Catalogo de estados de la solicitud de modificacion. Valores, solicitada, aprobada, rechazada y aplicada'
}

Table parametros.tipo_cambio_modificacion {
  ~parametro
  Note: 'Catalogo de tipos de cambio de una modificacion. Valores, item agregado, item modificado, item eliminado y fecha de cierre'
}

Table parametros.evento_notificacion {
  ~parametro
  Note: 'Catalogo de eventos que generan notificaciones. Valores, solicitud procesada, adenda, observacion respondida, subsanacion habilitada, decision y cierre'
}

Table parametros.plantilla_cargue {
  ~parametro
  Note: 'Catalogo de plantillas de cargue masivo de items. Valores por definir'
}

// ---------------------------------------------------------------------------
// Grupos
// ---------------------------------------------------------------------------

TableGroup cotizaciones_creacion_solicitud {
  cotizaciones.solicitud_cotizacion
  cotizaciones.solicitud_necesidad
  cotizaciones.solicitud_item
  cotizaciones.cargue_masivo
  cotizaciones.cargue_masivo_error
