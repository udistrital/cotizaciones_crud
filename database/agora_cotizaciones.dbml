  cotizaciones.solicitud_ciiu
  cotizaciones.documento_solicitud
  cotizaciones.solicitud_requisito_documental
  cotizaciones.solicitud_proveedor
}

TableGroup cotizaciones_gestion_solicitud {
  cotizaciones.observacion
  cotizaciones.respuesta_observacion
  cotizaciones.cotizacion
  cotizaciones.cotizacion_version
  cotizaciones.cotizacion_version_item
  cotizaciones.documento_cotizacion
  cotizaciones.periodo_subsanacion
  cotizaciones.decision_solicitante
  cotizaciones.validacion_ordenador
  cotizaciones.solicitud_modificacion
  cotizaciones.solicitud_modificacion_estado
  cotizaciones.solicitud_modificacion_detalle
  cotizaciones.solicitud_estado
  cotizaciones.cotizacion_estado
  cotizaciones.notificacion
}

TableGroup parametros_catalogos {
  parametros.tipo_proceso
  parametros.tipo_forma_pago
  parametros.estado_solicitud
  parametros.estado_observacion
  parametros.estado_cotizacion
  parametros.motivo_version
  parametros.estado_version
  parametros.estado_modificacion
  parametros.tipo_cambio_modificacion
  parametros.evento_notificacion
  parametros.plantilla_cargue
}


